{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QClipz",
  "version": "0.9.1",
  "identifier": "com.qclipz.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QClipz",
        "width": 1080,
        "height": 700,
        "minWidth": 880,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#121011"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data:",
        "media-src": "'self' asset: http://asset.localhost",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "QClipz",
    "category": "Video",
    "shortDescription": "Screen, area and window recorder",
    "externalBin": ["binaries/ffmpeg"],
    "resources": { "licenses/*": "licenses/" },
    "copyright": "Copyright (c) 2026 QClipz contributors. MIT License; bundles FFmpeg (GPLv3).",
    "longDescription": "QClipz records your screen, a dragged area or a window, with system sound and microphone, and saves an mp4 straight to your Videos folder.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
